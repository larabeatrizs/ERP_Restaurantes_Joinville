# Configurações VITE_* são públicas. Nunca inserir tokens ou credenciais administrativas.
# O proxy de desenvolvimento usa /api; não é necessário configurar URL neste recorte.
# URL e chave publicável do projeto existente; nunca preencher com service_role/sb_secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
