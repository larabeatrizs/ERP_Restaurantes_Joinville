{
  "name": "erp-restaurantes-joinville",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @erp/web",
    "dev:api": "npm run dev --workspace @erp/api",
    "lint": "eslint apps packages",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test:api && npm run test:db && npm run test:legacy",
    "test:api": "node --test apps/api/src/index.test.ts apps/api/src/settings.test.ts apps/api/src/supabase-settings.test.ts",
    "test:db": "node --test tests/database/configuracoes.test.mjs",
    "test:legacy": "node --test tests/database/legado.test.mjs",
    "test:web": "playwright test",
    "build": "npm run build --workspaces",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.65.0",
    "@types/node": "24.10.0",
    "eslint": "10.14.0",
    "pg": "8.23.1",
    "supabase": "3.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
